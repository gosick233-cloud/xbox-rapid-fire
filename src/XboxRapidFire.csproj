<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/App.ico</ApplicationIcon>
    <AssemblyName>XboxRapidFire</AssemblyName>
    <Version>1.2.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/App.ico" LogicalName="XboxRapidFire.AppIcon" />
    <EmbeddedResource Include="Assets/Strings.json" LogicalName="XboxRapidFire.Strings" />
    <Reference Include="Nefarius.ViGEm.Client">
      <HintPath>../deps/vigem-client/lib/netstandard2.0/Nefarius.ViGEm.Client.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
